from transformers import M2M100ForConditionalGeneration, M2M100Tokenizer

m="facebook/m2m100_418M"

t=M2M100Tokenizer.from_pretrained(m)

m=M2M100ForConditionalGeneration.from_pretrained(m)

lang={"hi":"hi","mr":"mr","gu":"gu","ta":"ta",
      "te":"te","fr":"fr","de":"de","es":"es"}

text=input("Text: ")

l=input("Language: ").lower()

t.src_lang="en"

x=t(text,return_tensors="pt")

y=m.generate(**x,forced_bos_token_id=t.get_lang_id(lang[l]))

print(t.decode(y[0],skip_special_tokens=True))
